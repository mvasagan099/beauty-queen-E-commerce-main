# Beauty Queen - Development Environment
# Copy to .env.development and fill in values
#
# SECURITY: Never commit .env files to version control.
# For production, use environment-specific secret management.

# Database (local MySQL)
DATABASE_URL="mysql://bq_user:bq_password@localhost:3306/beauty_queen"

# JWT - generate with: openssl rand -base64 48
# These are development-only values. Production MUST use unique, randomly generated secrets.
JWT_ACCESS_SECRET=dev-access-secret-change-me-to-random-32-chars-minimum!!
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-to-random-32-chars-minimum!!

# Razorpay (test mode keys from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Brevo (dev API key from https://app.brevo.com)
BREVO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=debug

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000/api
API_PROXY_TARGET=http://localhost:5000
