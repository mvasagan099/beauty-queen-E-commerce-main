# ============================================================================
# Beauty Queen E-Commerce — Environment Variables
# ============================================================================
# Copy this file to .env and fill in production values.
# NEVER commit .env to version control.
#
# Generate secure JWT secrets: openssl rand -base64 48
# ============================================================================

# --- Database (MySQL) ---
DATABASE_URL="mysql://user:password@localhost:3306/beauty_queen"

# --- JWT Authentication ---
# MUST be at least 32 characters each. Generate with: openssl rand -base64 48
# JWT_ACCESS_SECRET and JWT_REFRESH_SECRET MUST be different values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Razorpay Payment Gateway ---
# Get from https://dashboard.razorpay.com (Settings > API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from Razorpay dashboard (Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=

# --- Brevo Email Service ---
# Get from https://app.brevo.com (Settings > API Keys)
BREVO_API_KEY=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty for local unauthenticated Redis. In production set a strong password.
REDIS_PASSWORD=
# Set to "true" when Redis requires TLS (e.g., Redis Cloud, AWS ElastiCache)
# REDIS_TLS=true
# Alternative: full Redis URL (overrides REDIS_HOST/PORT/PASSWORD)
# REDIS_URL=rediss://:password@host:6379

# --- Worker Health Probe ---
WORKER_HEALTH_PORT=5001

# --- Server ---
PORT=5000
NODE_ENV=development
# In production, set to your actual domain (e.g., https://beautyqueen.com)
FRONTEND_URL=http://localhost:3000

# --- Logging ---
LOG_LEVEL=info

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:5000/api
API_PROXY_TARGET=http://localhost:5000

# --- Production Notes ---
# - Razorpay keys, webhook secret, and JWT secrets MUST be set in production
# - FRONTEND_URL must be the production domain URL
# - REDIS_PASSWORD should be set for production Redis
# - BREVO_API_KEY is required for email sending
# - For horizontal scaling: mount uploads/ to shared storage or use S3/GCS
