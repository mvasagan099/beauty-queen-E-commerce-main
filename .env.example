# Backend Environment Variables

# Database (MySQL)
DATABASE_URL="mysql://bq_user:bq_password@localhost:3306/beauty_queen"

# JWT - MUST be at least 32 characters each. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Razorpay (get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Brevo (get from https://app.brevo.com)
BREVO_API_KEY=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Redis authentication / TLS (used by the API, worker and BullMQ).
# Leave REDIS_PASSWORD empty for local, unauthenticated Redis. In production:
#   REDIS_PASSWORD=your-redis-password
#   REDIS_TLS=true   (true when Redis requires TLS / rediss://)
# Alternative: connect with a full URL (host/port ignored) e.g.
#   REDIS_URL=rediss://:your-password@your-redis-host:6379
# Production Redis must NOT be exposed to the public internet.

# Worker health probe port (liveness/readiness exposed by the worker container)
WORKER_HEALTH_PORT=5001

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

# --- Production-only (never set these locally) ---
# Product images are processed through Sharp and stored on the local
# filesystem under uploads/. For horizontally scaled production, mount a
# shared volume or move to object storage (S3/GCS) by adding an adapter in
# apps/api/src/common/image.service.ts. Object storage keys, when added:
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

