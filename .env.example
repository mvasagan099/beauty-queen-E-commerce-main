# ============================================================================
# Beauty Queen E-Commerce — Environment Variables
# ============================================================================
# Copy this file to .env and fill in production values.
# NEVER commit .env to version control.
#
# Generate secure JWT secrets: openssl rand -base64 48
# ============================================================================

# --- Database (MySQL) ---
DATABASE_URL="mysql://user:password@localhost:3306/beauty_queen"

# --- JWT Authentication ---
# MUST be at least 32 characters each. Generate with: openssl rand -base64 48
# JWT_ACCESS_SECRET and JWT_REFRESH_SECRET MUST be different values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Razorpay Payment Gateway ---
# Get from https://dashboard.razorpay.com (Settings > API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from Razorpay dashboard (Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=

# --- Brevo Email Service ---
# Get from https://app.brevo.com (Settings > API Keys)
BREVO_API_KEY=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty for local unauthenticated Redis. In production set a strong password.
REDIS_PASSWORD=
# Set to "true" when Redis requires TLS (e.g., Redis Cloud, AWS ElastiCache)
# REDIS_TLS=true
# Alternative: full Redis URL (overrides REDIS_HOST/PORT/PASSWORD)
# REDIS_URL=rediss://:password@host:6379

# --- Worker Health Probe ---
WORKER_HEALTH_PORT=5001

# --- Server ---
PORT=5000
NODE_ENV=development
# In production, set to your actual domain (e.g., https://beautyqueen.com)
FRONTEND_URL=http://localhost:3000

# --- Logging ---
LOG_LEVEL=info

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:5000/api
API_PROXY_TARGET=http://localhost:5000

# --- GST Tax Invoice Metadata (optional) ---
# STORE_LEGAL_NAME="Beauty Queen Fashion & Cosmetics"
# STORE_GSTIN="33AAACB0000A1Z5"

# --- Cloud Media Storage (S3 / Cloudflare R2 + CDN, optional) ---
# MEDIA_STORAGE_DRIVER=local # "local" or "s3"
# MEDIA_CDN_BASE_URL=https://cdn.beautyqueen.in
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Indian Courier Integration (Shiprocket, optional) ---
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# SHIPROCKET_PICKUP_PINCODE=600001
# SHIPROCKET_WEBHOOK_TOKEN=

# --- Observability & Error Alerting (optional) ---
# Slack / Discord / PagerDuty webhook for unhandled 5xx alerts
# ALERT_WEBHOOK_URL=

# --- WhatsApp Business Cloud API (optional) ---
# Meta Cloud API for order updates & COD verification
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_API_VERSION=v20.0

# --- Google 1-Tap OAuth Sign-In (optional) ---
# GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- PWA Web Push & Retention Automation (optional) ---
# ABANDONED_CART_RECOVERY_ENABLED=true
# VAPID_PUBLIC_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# --- Production Notes ---
# - Razorpay keys, webhook secret, and JWT secrets MUST be set in production
# - FRONTEND_URL must be the production domain URL
# - REDIS_PASSWORD should be set for production Redis
# - BREVO_API_KEY is required for email sending
# - For horizontal scaling: set MEDIA_STORAGE_DRIVER=s3 with S3/R2 + MEDIA_CDN_BASE_URL
