# Normalize line endings across the repo
* text=auto

# Shell scripts must stay LF on all platforms
*.sh text eol=lf

# Lock/generated files
*.lock binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.svg text eol=lf

# Line ending normalization for source
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
