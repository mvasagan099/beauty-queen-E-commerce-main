# Beauty Queen - Test Environment
# Copy to .env.test and fill in values

# Database (test MySQL - separate from dev)
DATABASE_URL="mysql://bq_test_user:bq_test_password@localhost:3306/beauty_queen_test"

# JWT - generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=test-access-secret-minimum-32-characters-long!!
JWT_REFRESH_SECRET=test-refresh-secret-minimum-32-characters-long!!

# Razorpay (test mode keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Brevo (test API key)
BREVO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Server
PORT=5001
NODE_ENV=test
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=warn

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5001/api
API_PROXY_TARGET=http://localhost:5001
