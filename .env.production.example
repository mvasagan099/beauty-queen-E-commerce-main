# Beauty Queen - Production Environment
# Copy to .env.production on the production server and fill in ALL values
# NEVER commit this file with real credentials

# Database (production MySQL)
DATABASE_URL="mysql://bq_user:CHANGE_ME@mysql:3306/beauty_queen"

# JWT - generate with: openssl rand -base64 48
# MUST be at least 32 characters. MUST be different from dev/test.
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48

# Razorpay (LIVE keys from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_live_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# Brevo (production API key from https://app.brevo.com)
BREVO_API_KEY=CHANGE_ME

# MySQL (for backup/restore scripts)
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32
# REDIS_TLS=true

# Worker health probe port
WORKER_HEALTH_PORT=5001

# Server
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://YOUR-DOMAIN.com

# Logging (production should use warn or info)
LOG_LEVEL=info

# Frontend
NEXT_PUBLIC_API_URL=https://YOUR-DOMAIN.com/api
API_PROXY_TARGET=http://api:5000

# Domain configuration (replace YOUR-DOMAIN.com)
# Used by Nginx, CORS, and security headers
APP_DOMAIN=YOUR-DOMAIN.com
APP_WWW_DOMAIN=www.YOUR-DOMAIN.com
API_DOMAIN=api.YOUR-DOMAIN.com
