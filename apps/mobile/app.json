{
  "expo": {
    "name": "Beauty Queen",
    "slug": "beauty-queen-atelier",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "beautyqueen",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A0B10"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beautyqueen.atelier",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.beautyqueen.atelier",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A0B10"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
